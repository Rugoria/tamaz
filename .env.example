# Production color scheme: clinical (default), elastic, mint, ocean, rose, sunny,
# lavender, sage, champagne or graphite. See tamaz-handoff/COLOR-SCHEMES.md.
SITE_SCHEME=clinical

# Show the floating "Color scheme" picker. For client review builds only; leave
# unset in production. Inlined at build time, so rebuild after changing it.
NEXT_PUBLIC_SHOW_SCHEME_PICKER=false

# Google Maps Embed API key for the studio map. Restrict it to your domains
# (HTTP referrers) in Google Cloud. Without it the map uses the keyless embed.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
